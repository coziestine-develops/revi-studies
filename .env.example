# Frontend (safe to ship: publishable key only, protected by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Edge Function secrets: set these in Supabase, never in this project
#   supabase secrets set GROQ_API_KEY=... GROQ_MODEL=openai/gpt-oss-120b
# Never put the Groq key in this file or in a VITE_ variable: anything starting with VITE_ is shipped to the browser.

# Google reCAPTCHA v2 (checkbox) site key. Public, so it is safe in the frontend.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Server-only secret for the verify-recaptcha Edge Function. Set it with `supabase secrets set`, never here.
#   supabase secrets set RECAPTCHA_SECRET_KEY=...

# EmailJS (feedback form). All three are public browser keys, safe in the frontend.
# Create an email service + template at emailjs.com. Template variables are listed in SETUP.md.
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key

# Firebase (Google sign-in). Copy these from Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
